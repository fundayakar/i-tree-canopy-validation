"""
Point-level correlation analysis among ecosystem-service proxies.

This is the final analysis addressing the reviewer's concern about the
mean-based correlation (n=4). We now use n~20,000 sampling points and
three independent ecosystem-service proxies:

    Carbon biomass / sequestration   ->  EVI    (Enhanced Vegetation Index)
    Air-pollution interception       ->  FCover (sub-pixel canopy fraction)
    Runoff buffering capacity        ->  1-BSI  (vegetation/non-bare cover)

EVI uses blue-red-NIR with non-NDVI coefficients, providing a methodologically
independent biomass proxy (avoids circular reasoning with FCover, which is an
NDVI rescaling).

Outputs:
    - Pearson and Spearman correlation matrices
    - Bootstrap 95% confidence intervals (1000 iterations)
    - p-values
    - Scatter plot matrix
    - Correlation heatmap
"""
import numpy as np
import pandas as pd
from scipy import stats
from pathlib import Path
import matplotlib.pyplot as plt
from matplotlib.colors import LinearSegmentedColormap

# -----------------------------------------------------------------------------
# 1. LOAD AND MERGE DATA
# -----------------------------------------------------------------------------
df_proxies = pd.read_csv("/mnt/user-data/uploads/Eymir_point_level_proxies.csv")
df_evi = pd.read_csv("/mnt/user-data/uploads/Eymir_point_EVI.csv")

print(f"Proxies CSV: {len(df_proxies)} points")
print(f"EVI CSV: {len(df_evi)} points")

df = df_proxies.merge(df_evi, on='point_id', how='inner')
print(f"After merge: {len(df)} points")

# Drop NaN, drop water (MNDWI > 0 or NDVI very low)
df_clean = df.dropna()
df_land = df_clean[(df_clean['NDVI'] >= 0.05) & (df_clean['MNDWI'] < 0)].copy()
print(f"After dropping water: {len(df_land)}")

# Compute service-level proxies
df_land['Carbon_proxy']   = df_land['EVI']            # carbon biomass density
df_land['AirPoll_proxy']  = df_land['FCover']         # interception surface
df_land['Runoff_proxy']   = 1.0 - df_land['BSI']      # vegetation cover, infiltration capacity

# -----------------------------------------------------------------------------
# 2. SUMMARY STATS PER PROXY
# -----------------------------------------------------------------------------
proxies = ['Carbon_proxy', 'AirPoll_proxy', 'Runoff_proxy']
labels = {
    'Carbon_proxy':  'Carbon biomass (EVI)',
    'AirPoll_proxy': 'Air-pollution interception (FCover)',
    'Runoff_proxy':  'Runoff buffering capacity (1 - BSI)'
}
short_labels = {
    'Carbon_proxy':  'Carbon (EVI)',
    'AirPoll_proxy': 'Air pollution (FCover)',
    'Runoff_proxy':  'Runoff (1-BSI)'
}

print("\n=== SUMMARY STATISTICS ===")
print(df_land[proxies].describe().round(3).to_string())

# -----------------------------------------------------------------------------
# 3. PAIRWISE CORRELATIONS
# -----------------------------------------------------------------------------
data = df_land[proxies].values
n = data.shape[1]

def pairwise_corr(data, method='pearson'):
    n = data.shape[1]
    r = np.zeros((n, n))
    p = np.zeros((n, n))
    for i in range(n):
        for j in range(n):
            if method == 'pearson':
                r[i, j], p[i, j] = stats.pearsonr(data[:, i], data[:, j])
            else:
                r[i, j], p[i, j] = stats.spearmanr(data[:, i], data[:, j])
    return r, p

r_pear, p_pear = pairwise_corr(data, 'pearson')
r_spear, p_spear = pairwise_corr(data, 'spearman')

print("\n=== PEARSON CORRELATIONS (3 ecosystem-service proxies) ===")
df_pear = pd.DataFrame(r_pear, index=[short_labels[p] for p in proxies],
                                columns=[short_labels[p] for p in proxies])
print(df_pear.round(3).to_string())

print("\n=== SPEARMAN CORRELATIONS ===")
df_spear = pd.DataFrame(r_spear, index=[short_labels[p] for p in proxies],
                                  columns=[short_labels[p] for p in proxies])
print(df_spear.round(3).to_string())

# -----------------------------------------------------------------------------
# 4. BOOTSTRAP 95% CIs
# -----------------------------------------------------------------------------
def bootstrap_ci(x, y, n_boot=1000, ci=95, method='pearson'):
    n = len(x)
    rng = np.random.default_rng(42)
    rs = []
    for _ in range(n_boot):
        idx = rng.integers(0, n, n)
        if method == 'pearson':
            r, _ = stats.pearsonr(x[idx], y[idx])
        else:
            r, _ = stats.spearmanr(x[idx], y[idx])
        rs.append(r)
    rs = np.array(rs)
    lo = np.percentile(rs, (100 - ci) / 2)
    hi = np.percentile(rs, 100 - (100 - ci) / 2)
    return lo, hi

print("\n=== BOOTSTRAP 95% CIs (Pearson, 1000 iter) ===")
print(f"{'Pair':<55} {'r':>8} {'95% CI':>22} {'p':>10}")
results = []
for i in range(n):
    for j in range(i + 1, n):
        x = data[:, i]; y = data[:, j]
        lo, hi = bootstrap_ci(x, y, 1000, method='pearson')
        lo_s, hi_s = bootstrap_ci(x, y, 1000, method='spearman')
        pair_str = f"{short_labels[proxies[i]]} vs {short_labels[proxies[j]]}"
        ci = f"[{lo:.3f}, {hi:.3f}]"
        p = f"{p_pear[i,j]:.2e}" if p_pear[i,j] < 0.001 else f"{p_pear[i,j]:.4f}"
        print(f"{pair_str:<55} {r_pear[i,j]:>8.3f} {ci:>22} {p:>10}")
        results.append({
            'pair_i': proxies[i], 'pair_j': proxies[j],
            'pair_label': pair_str,
            'pearson_r': r_pear[i, j],
            'pearson_ci_lo': lo, 'pearson_ci_hi': hi,
            'pearson_p': p_pear[i, j],
            'spearman_r': r_spear[i, j],
            'spearman_ci_lo': lo_s, 'spearman_ci_hi': hi_s,
            'spearman_p': p_spear[i, j],
        })

results_df = pd.DataFrame(results)
out_dir = Path("/home/claude/correlation_analysis")
out_dir.mkdir(exist_ok=True)
results_df.to_csv(out_dir / "service_correlation_bootstrap.csv", index=False)
print(f"\nSaved: {out_dir / 'service_correlation_bootstrap.csv'}")

# -----------------------------------------------------------------------------
# 5. SCATTER MATRIX FIGURE (3 pairs)
# -----------------------------------------------------------------------------
pairs = [('Carbon_proxy', 'AirPoll_proxy'),
         ('Carbon_proxy', 'Runoff_proxy'),
         ('AirPoll_proxy', 'Runoff_proxy')]

fig, axes = plt.subplots(1, 3, figsize=(15, 5.2))

for idx, (xv, yv) in enumerate(pairs):
    ax = axes[idx]
    x = df_land[xv].values
    y = df_land[yv].values

    # 2D density (hexbin) for clarity at n=20,000
    hb = ax.hexbin(x, y, gridsize=45, cmap='Greens', mincnt=1)

    # Linear fit
    coeffs = np.polyfit(x, y, 1)
    xfit = np.linspace(x.min(), x.max(), 100)
    yfit = coeffs[0] * xfit + coeffs[1]
    ax.plot(xfit, yfit, 'r-', linewidth=1.6, alpha=0.85)

    # Stats
    r, p = stats.pearsonr(x, y)
    rs, _ = stats.spearmanr(x, y)
    pair_results = [r for r in results if r['pair_i'] == xv and r['pair_j'] == yv]
    if pair_results:
        ci_lo = pair_results[0]['pearson_ci_lo']
        ci_hi = pair_results[0]['pearson_ci_hi']
    else:
        ci_lo = ci_hi = None

    ax.set_xlabel(short_labels[xv], fontsize=11)
    ax.set_ylabel(short_labels[yv], fontsize=11)
    title = (f"r = {r:.3f}, ρ = {rs:.3f}\n"
             f"95% CI [{ci_lo:.3f}, {ci_hi:.3f}], p < 0.001")
    ax.set_title(title, fontsize=10)
    ax.grid(alpha=0.3)

    cbar = plt.colorbar(hb, ax=ax, fraction=0.045, pad=0.02)
    cbar.set_label("Point density", fontsize=9)
    cbar.ax.tick_params(labelsize=8)

plt.suptitle(f"Pairwise correlations among ecosystem-service proxies "
             f"(n = {len(df_land):,} sampling points)", fontsize=12, y=1.02)
plt.tight_layout()

fig_dir = Path("/home/claude/itree-proxy-repo/figures")
fig_dir.mkdir(exist_ok=True)
plt.savefig(fig_dir / "fig5_service_correlations.png", dpi=300, bbox_inches='tight')
plt.savefig(fig_dir / "fig5_service_correlations.pdf", bbox_inches='tight')
plt.close()
print(f"Saved: fig5_service_correlations.png/.pdf")

# -----------------------------------------------------------------------------
# 6. SIMPLE 3x3 HEATMAP (compact)
# -----------------------------------------------------------------------------
fig, ax = plt.subplots(figsize=(6.5, 5.5))
cmap = LinearSegmentedColormap.from_list("rwb", ["#c0392b", "white", "#2980b9"], N=256)
im = ax.imshow(r_pear, cmap=cmap, vmin=-1, vmax=1, aspect='equal')
ax.set_xticks(range(n))
ax.set_yticks(range(n))
labels_short = ['Carbon\n(EVI)', 'Air pollution\n(FCover)', 'Runoff\n(1-BSI)']
ax.set_xticklabels(labels_short, fontsize=10)
ax.set_yticklabels(labels_short, fontsize=10)
ax.set_title(f'Pearson correlation matrix\n(n = {len(df_land):,} sampling points, all p < 0.001)',
             fontsize=11)

for i in range(n):
    for j in range(n):
        v = r_pear[i, j]
        color = 'white' if abs(v) > 0.55 else 'black'
        ax.text(j, i, f'{v:.3f}', ha='center', va='center',
                fontsize=12, color=color, fontweight='bold')

plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04, label='Pearson r')
plt.tight_layout()
plt.savefig(fig_dir / "fig6_correlation_heatmap.png", dpi=300, bbox_inches='tight')
plt.savefig(fig_dir / "fig6_correlation_heatmap.pdf", bbox_inches='tight')
plt.close()
print(f"Saved: fig6_correlation_heatmap.png/.pdf")

print("\n=== DONE ===")
